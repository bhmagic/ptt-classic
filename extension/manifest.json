{
  "manifest_version": 3,
  "name": "PTT Classic",
  "version": "0.1.1",
  "description": "The classic PTT terminal in a Chrome tab. Connects directly to PTT with a narrowly scoped Origin rule; no relay.",
  "minimum_chrome_version": "101",
  "key": "",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "Open PTT Classic", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequestWithHostAccess", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["wss://ws.ptt.cc/*", "https://*.imgur.com/*", "https://www.youtube.com/*", "https://i.verb.tw/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "ptt_origin", "enabled": true, "path": "rules.json" }]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' wss://ws.ptt.cc/bbs https://api.flickr.com https://api.imgur.com; frame-src https://www.youtube.com;"
  }
}
